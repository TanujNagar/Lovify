# Shared YouTube Data API v3 key.
# Server-side only. Never prefix this with VITE_ or NEXT_PUBLIC_.
# Without it, Lovify simply searches Audius and Jamendo.
YOUTUBE_API_KEY=

# Optional public Jamendo client id for the build.
# Users can also paste their own id in Settings, where it stays in IndexedDB.
VITE_JAMENDO_CLIENT_ID=
